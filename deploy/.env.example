# ================================================================
# docker-compose 环境变量模板。cp .env.example .env 后按需修改。
# ================================================================

# ---- MySQL ----
MYSQL_ROOT_PASSWORD=
MYSQL_USER=gpt2api
MYSQL_PASSWORD=
MYSQL_DATABASE=gpt2api
MYSQL_PORT=3306

# ---- Redis ----
REDIS_PORT=6379

# ---- Server ----
HTTP_PORT=8080
# 电商资产库本地上传目录在容器内固定为 /app/data/ecommerce-assets,由 docker volume 持久化。

# ---- ImageGen (AI Zero Token) ----
# 生图网关 API Key,容器内默认通过 AZT_API_KEY 读取。
AZT_API_KEY=
# 视频网关 API Key，供画布视频节点和视频体验页读取。
AI_GEN_API_KEY=

# ---- Security (生产强制改!) ----
# JWT 签名密钥,至少 32 字符；必须生成随机值，禁止使用示例或占位词。
JWT_SECRET=
# AES-256 加密 KEY,用于加密账号的 AT/Cookie 等。必须 64 位 hex(32 字节)
CRYPTO_AES_KEY=
# 视频画布媒体 URL 与费用确认令牌签名密钥，至少 32 字节。
VIDEO_WORKFLOW_SIGNING_SECRET=
# 上游视频服务访问参考图时使用；填写真实公网 origin，禁止 example.com、localhost 或内网地址。
VIDEO_WORKFLOW_PUBLIC_BASE_URL=

# ---- Backup ----
# 保留最近 N 个备份,0 代表不清理
BACKUP_RETENTION=30
# 是否启用"数据库恢复"端点(超危)。生产默认 false,
# 需要恢复时先设置为 true 重启容器,完成后切回 false。
BACKUP_ALLOW_RESTORE=false
